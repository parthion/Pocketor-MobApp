# Pocketor Mobile App - MySQL Database Configuration

# This file contains the environment variables needed to connect to your MySQL backend server
# Copy this file to .env.local and update the values accordingly

# ============= Backend Server Configuration =============
EXPO_PUBLIC_API_URL=http://192.168.1.13:3000/api
EXPO_PUBLIC_API_TIMEOUT=10000

# ============= MySQL Backend Setup Instructions =============
# 
# 1. Make sure you have MySQL server running on your system
#    - macOS: brew install mysql, then brew services start mysql
#    - Windows: Download MySQL installer from mysql.com
#    - Linux: sudo apt-get install mysql-server
#
# 2. Create a new Node.js/Express backend server
#    - mkdir pocketor-backend
#    - cd pocketor-backend
#    - npm init -y
#    - npm install express mysql2 bcryptjs jsonwebtoken dotenv cors
#
# 3. Set up your backend .env file with:
#    DATABASE_HOST=localhost
#    DATABASE_PORT=3306
#    DATABASE_USER=root
#    DATABASE_PASSWORD=your_password
#    DATABASE_NAME=pocketor
#
# 4. Create the MySQL database using the SQL schema in DATABASE_SETUP.md
#
# 5. Implement the backend routes as documented in DATABASE_SETUP.md
#
# 6. Update EXPO_PUBLIC_API_URL below with your backend server URL
#    - Local development: http://localhost:3000/api
#    - Production: https://your-domain.com/api

# ============= Feature Flags =============
EXPO_PUBLIC_USE_MYSQL=true
EXPO_PUBLIC_USE_LOCAL_STORAGE=false

# ============= Logging =============
EXPO_PUBLIC_DEBUG_MODE=true
